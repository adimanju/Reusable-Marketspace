{
  "name": "reusable-marketspace-backend",
  "version": "1.0.0",
  "description": "Backend API for Reusable Marketspace - Bulk Recycled Electronics Trading Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "cd ../frontend && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "jest --coverage",
    "seed": "node scripts/seedDatabase.js"
  },
  "keywords": [
    "marketplace",
    "recycled-electronics",
    "bulk-trading",
    "ecommerce",
    "e-kyc"
  ],
  "author": "Reusable Marketspace Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.15.3",
    "nodemailer": "^7.0.10",
    "razorpay": "^2.9.2",
    "redis": "^4.6.11",
    "twilio": "^4.19.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.53.0",
